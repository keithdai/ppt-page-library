{
  "name": "ppt-page-library-desktop",
  "productName": "拼页",
  "version": "0.1.0",
  "description": "拼页 PinPage · 好页拼成好稿——本地 PPTX 导入渲染、按页选片、组合导出。",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.pptlib.desktop",
    "productName": "拼页",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    }
  }
}
